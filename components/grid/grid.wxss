/* components/grid/grid.wxss */
.grid-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(5, 1fr);
  gap: 8rpx;
  background: white;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.grid-cell {
  aspect-ratio: 1;
  background: #f8f9fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.grid-cell:active {
  background: #e9ecef;
  transform: scale(0.95);
}

.grid-cell.selected {
  background: #ff6b6b;
  border-color: #e55656;
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.4);
}

.grid-cell.bomb {
  background: #e17055;
}

.grid-cell.exploded {
  background: #d63031;
  animation: explode 0.5s ease-out;
}

.cell-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.cell-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.cell-index {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  font-size: 20rpx;
  color: #999;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 4rpx;
  padding: 2rpx 6rpx;
  line-height: 1;
}

@keyframes explode {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
